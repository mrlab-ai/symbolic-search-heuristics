# Paper build and bibliography management.
# Bibliography files under bib/ are fetched from https://github.com/aibasel/bib
# via `make update-bib`; do not edit them directly (edit extra.bib for entries
# not yet in the shared repository).

.PHONY: paper paperA paperB update-bib clean

paper: paper.pdf
paperA: paperA.pdf
paperB: paperB.pdf

paper%.pdf: paper%.tex $(wildcard bib/*.bib)
	pdflatex -interaction=nonstopmode $(basename $@).tex
	bibtex $(basename $@)
	pdflatex -interaction=nonstopmode $(basename $@).tex
	pdflatex -interaction=nonstopmode $(basename $@).tex

paper.pdf: paper.tex $(wildcard bib/*.bib) extra.bib
	pdflatex -interaction=nonstopmode paper.tex
	bibtex paper
	pdflatex -interaction=nonstopmode paper.tex
	pdflatex -interaction=nonstopmode paper.tex

update-bib:
	note='DO NOT EDIT THIS FILE DIRECTLY! It is overwritten by "make update-bib".'; \
	mkdir -p bib; \
	for name in abbrv-short abbrv literatur crossref-short crossref; do \
	    file=bib/$${name}.bib; \
	    wget -q https://raw.githubusercontent.com/aibasel/bib/main/$${name}.bib -O $${file}; \
	    printf '%% %s\n\n%s\n' "$${note}" "$$(cat $${file})" > $${file}; \
	done; \
	echo "$${note}" > bib/DO_NOT_EDIT_THESE_FILES

clean:
	rm -f paper*.aux paper*.bbl paper*.blg paper*.log paper*.out paper*.pdf
